[run]
branch = True
source = apps, config
omit =
    */migrations/*
    */tests.py
    */test_*.py
    config/asgi.py
    config/wsgi.py
    manage.py

[report]
show_missing = False
# Abstract hooks that subclasses must override can never run themselves.
exclude_also =
    raise NotImplementedError
    if TYPE_CHECKING:
skip_covered = True
# CI fails below this (course Definition of Done: coverage >= 80%).
fail_under = 80
