# ---------------------------------------------------------------------------
# FOLDO — example environment file
# ---------------------------------------------------------------------------
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit the real `.env` (it is git-ignored). Only this example is tracked.
# Leave a value blank to fall back to the documented default in settings.py.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate a unique key for any shared/deployed environment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
# Keep True locally. MUST be False in production.
DJANGO_DEBUG=True
# Comma-separated hostnames Django will answer for.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for CSRF (needed behind HTTPS in production).
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
# DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=DEBUG

# --- Production security (only applied when DJANGO_DEBUG=False) -----------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=604800

# --- Application -----------------------------------------------------------
FOLDO_VERSION=0.1.0

# --- Database --------------------------------------------------------------
# Local development: leave DB_ENGINE as sqlite (no server required).
DB_ENGINE=sqlite
# Production: set DB_ENGINE=postgresql and fill the values below.
DB_NAME=foldo
DB_USER=foldo
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (caching / future task queue) -----------------------------------
# Leave blank to use the in-process cache during local development.
REDIS_URL=
