          <mxGeometry x="1260" y="1978" width="560" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p1_legend_title" value="&lt;b&gt;Legend (Chen notation)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="page-core-1">
